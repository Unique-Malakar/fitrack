# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# In GitHub Actions these are repository secrets, not a file.

# --- Data sources ---
# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Free, instant: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Email delivery ---
# Gmail requires an App Password (16 chars, 2FA must be on), NOT your account
# password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=you@gmail.com
# Comma-separated for multiple recipients.
EMAIL_TO=you@gmail.com
